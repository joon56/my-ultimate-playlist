# 원자료, 중간 파일, 좌표가 든 파일 (비공개 저장소에서도 올리지 않는다)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/private/*
!data/private/.gitkeep

# 영상(얼굴이 나온다). 영상에서 읽은 값만 data/video_*.csv로 둔다
*.mp4
*.MP4
*.mov
*.MOV

# 다시 만들 수 있는 결과(D-64). 남길 결과는 G3에서 results/frozen/으로 동결한다
results/*
!results/.gitkeep
!results/frozen/
results_synthetic/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Claude Code 개인 설정
.claude/settings.local.json

# 발표 슬라이드의 영상 클립·장면 이미지·그림(사람이 나온다. 원본 영상에서 다시 만든다)
docs/slides/media/
docs/slides/PPT용_영상_이미지/
docs/slides/*.zip
